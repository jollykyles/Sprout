{
  "manifest_version": 3,
  "name": "Sprout \u2014 Learn to Watch",
  "version": "1.2.0",
  "description": "Pauses YouTube with a quick learning question tailored to your child's level and the video they're watching. Answer it (or use the parent PIN) to keep watching.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://api.anthropic.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "questions.js",
        "content.js"
      ],
      "css": [
        "gate.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sprout settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}